PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/training_module_backend
# Attempt persistence and certificate downloads require opt-in development demo mode.
NODE_ENV=development
CERTIFICATE_DEMO_MODE=false
CERTIFICATE_PASSING_PERCENTAGE=80
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=30000
CHAT_DIAGNOSTICS=false
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
